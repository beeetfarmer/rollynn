<?xml version="1.0" encoding="utf-8"?>
<!-- Sits on the player's lyrics background (dark colour blobs), so everything is white. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/player_cover_overhang">

    <LinearLayout
        android:id="@+id/lyrics_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/lyrics_header_art"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:elevation="6dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Lyrics.HeaderArt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lyrics_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_bold"
                android:letterSpacing="-0.01"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/lyrics_header_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textColor="#B8FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- In place of the header while the controls are hidden. -->
    <LinearLayout
        android:id="@+id/lyrics_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:alpha="0"
        android:background="@drawable/bg_lyrics_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/lyrics_pill_art"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleShapeAppearance" />

        <TextView
            android:id="@+id/lyrics_pill_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semi_bold"
            android:maxLines="1"
            android:textColor="#D9FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lyrics_not_synced_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter_semi_bold"
        android:text="@string/lyrics_not_synced"
        android:textColor="#B8FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lyrics_header" />

    <com.cappielloantonio.tempo.ui.view.FadingEdgeLayout
        android:id="@+id/lyrics_fade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/lyrics_bottom_barrier"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lyrics_header">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lyrics_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="24dp"
            android:paddingEnd="28dp"
            android:scrollbars="none" />
    </com.cappielloantonio.tempo.ui.view.FadingEdgeLayout>

    <TextView
        android:id="@+id/lyrics_empty_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:fontFamily="@font/inter_semi_bold"
        android:gravity="center"
        android:text="@string/lyrics_not_available"
        android:textColor="#B8FFFFFF"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/lyrics_fade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/lyrics_fade" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/lyrics_bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="lyrics_actions_bar,lyrics_immersive_hint" />

    <!-- Translate, download and lyrics source, under the lyrics. -->
    <LinearLayout
        android:id="@+id/lyrics_actions_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/translate_lyrics_button"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:cornerRadius="64dp"
            app:icon="@drawable/ic_translate"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/download_lyrics_button"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/player_lyrics_download_content_description"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:cornerRadius="64dp"
            app:icon="@drawable/ic_download"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lyrics_source_toggle_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:contentDescription="@string/player_lyrics_source_server_content_description"
            android:text="@string/player_lyrics_source_server_label"
            android:textAllCaps="false"
            android:textSize="11sp"
            android:visibility="gone"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="64dp"
            app:icon="@drawable/ic_swap_horiz"
            app:iconGravity="textStart"
            app:iconPadding="2dp"
            app:iconSize="14dp" />
    </LinearLayout>

    <!-- While the controls are hidden: a hint and a thin progress line. -->
    <TextView
        android:id="@+id/lyrics_immersive_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/inter_semi_bold"
        android:text="@string/lyrics_tap_to_show_controls"
        android:textColor="#B8FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lyrics_immersive_progress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/lyrics_immersive_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="22dp"
        android:max="1000"
        android:visibility="gone"
        app:indicatorColor="#DBFFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:trackColor="#3DFFFFFF"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
