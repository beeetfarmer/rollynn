<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dock_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="32dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/dock_items_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp" />

    <!-- Shown instead of the items while the dock is minimized; size set in code. -->
    <ImageView
        android:id="@+id/dock_compact_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/dock_show_navigation"
        android:scaleType="center"
        android:src="@drawable/ic_view_grid"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

</com.google.android.material.card.MaterialCardView>